# .env 예시 파일

# OpenObserve 활성화
OPENOBSERVE_ENABLED=true

# OpenObserve 서버 URL
OPENOBSERVE_URL=http://localhost:5080

# OpenObserve 조직 이름
OPENOBSERVE_ORGANIZATION=default

# OpenObserve 스트림 이름
OPENOBSERVE_STREAM=laravel-logs

# OpenObserve 인증 정보
OPENOBSERVE_USERNAME=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123

# 배치 크기 (선택사항)
OPENOBSERVE_BATCH_SIZE=100

# HTTP 타임아웃 (초, 선택사항)
OPENOBSERVE_TIMEOUT=5

# SSL 검증 (선택사항)
OPENOBSERVE_SSL_VERIFY=true
