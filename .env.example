# .env example file

# Enable OpenObserve
OPENOBSERVE_ENABLED=true

# OpenObserve server URL
OPENOBSERVE_URL=http://localhost:5080

# OpenObserve organization name
OPENOBSERVE_ORGANIZATION=default

# OpenObserve stream name
OPENOBSERVE_STREAM=laravel-logs

# OpenObserve authentication credentials
OPENOBSERVE_EMAIL=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123

# Batch size (optional)
OPENOBSERVE_BATCH_SIZE=100

# HTTP timeout in seconds (optional)
OPENOBSERVE_TIMEOUT=5

# SSL verification (optional)
OPENOBSERVE_SSL_VERIFY=true
