{
    "name": "weijukeji/laravel-openobserve",
    "description": "Laravel package for OpenObserve integration - centralized log management and monitoring",
    "type": "library",
    "keywords": ["laravel", "openobserve", "logging", "monitoring", "observability"],
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/overworks/laravel-openobserve/issues",
        "source": "https://github.com/overworks/laravel-openobserve"
    },
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Weijukeji\\LaravelOpenObserve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weijukeji\\LaravelOpenObserve\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weijukeji\\LaravelOpenObserve\\OpenObserveServiceProvider"
            ],
            "aliases": {
                "OpenObserve": "Weijukeji\\LaravelOpenObserve\\Facades\\OpenObserve"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
