{
    "name": "minhyung/laravel-openobserve",
    "description": "Laravel package for OpenObserve integration - centralized log management and monitoring",
    "keywords": ["laravel", "openobserve", "logging", "monitoring", "observability"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\LaravelOpenObserve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\LaravelOpenObserve\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Minhyung\\LaravelOpenObserve\\OpenObserveServiceProvider"
            ],
            "aliases": {
                "OpenObserve": "Minhyung\\LaravelOpenObserve\\Facades\\OpenObserve"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
